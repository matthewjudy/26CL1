{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/cli/chat.ts",
    "src/cli/cron.ts",
    "src/cli/dashboard.ts",
    "src/cli/index.ts",
    "src/channels/discord.ts",
    "src/agent/assistant.ts",
    "src/agent/prompt-cache.ts",
    "src/tools/mcp-server.ts"
  ]
}
